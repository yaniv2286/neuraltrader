# NeuralTrader production schedule (America/New_York - US market time)
# Each job grabs a file lock so overlapping runs cannot clobber state.
#
# 07:00 ET -> pre-market data refresh (fetch fresh EOD data from Tiingo)
# 09:35 ET -> market-open execution (exits + new entries)
# 16:35 ET -> post-market daily report
#
# All output is appended to /app/logs/cron_<mode>.log inside the container.

PATH=/usr/local/bin:/usr/bin:/bin
SHELL=/bin/bash

0 7 * * 1-5 root /usr/bin/flock -n /app/data/neuraltrader.lock -c '/app/run_mode.sh fetch' >> /app/logs/cron_fetch.log 2>&1
35 9 * * 1-5 root /usr/bin/flock -n /app/data/neuraltrader.lock -c '/app/run_mode.sh paper' >> /app/logs/cron_paper.log 2>&1
35 16 * * 1-5 root /usr/bin/flock -n /app/data/neuraltrader.lock -c '/app/run_mode.sh report' >> /app/logs/cron_report.log 2>&1
